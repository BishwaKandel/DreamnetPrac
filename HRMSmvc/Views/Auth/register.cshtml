@using Domain.DTO
@model RegisterDTO
@{
    Layout = "_LoginLayout";
}

<section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12 d-flex flex-column align-items-center justify-content-center">

                <div class="card mb-10">

                    <div class="card-body">

                        <div class="pt-4 pb-2">
                            <h5 class="card-title text-center pb-0 fs-4">Register Account</h5>
                            <p class="text-center small">Enter credentials to register</p>
                        </div>
                        <form id="registerForm" asp-action="Register" enctype="multipart/form-data" method="post">
                            <div class="row mb-3">
                                <div class="col-9">
                                    <label for="Name" class="form-label">Name</label>
                                    <input asp-for="Name" class="form-control" autocomplete="off">
                                </div>

                                <div class="col-3 text-center">
                                    <!-- Profile Picture Section -->
                                    <div class="position-relative d-inline-block">
                                        <img id="registerPreview"
                                             src="~/images/defultpfp.jpg"
                                             alt="Profile"
                                             style="width: 60px; height: 55px; border-radius: 50%; object-fit: cover; border: 1px solid #ccc;">

                                        <a class="btn btn-primary btn-sm position-absolute"
                                           id="registerUploadBtn"
                                           style="bottom: 0; right: 0; transform: translate(30%, 30%); border-radius: 50%; padding: 4px 6px;">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <input asp-for="formFile" type="file" class="d-none" id="registerFile" accept="image/*" />
                                    </div>

                                    <label for="ProfilePicture" class="form-label mt-2 d-block">Profile Picture</label>
                                </div>

                                <!-- Crop Modal -->
                                <div class="modal fade" id="registerCropModal" tabindex="-1" aria-labelledby="registerCropModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="registerCropModalLabel">Crop Profile Picture</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-center">
                                                <img id="registerCropImage" style="max-width:100%; display:block;" />
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-primary" id="registerCropAndSetBtn">Crop & Set</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label for="UserName" class="form-label">UserName</label>
                                    <input asp-for="UserName" class="form-control" autocomplete="off">
                                </div>
                                <div class="col-6">
                                    <label for="Position" class="form-label">Position</label>
                                    <select asp-for="Position" class="form-control">
                                        <option value="">-- Select Position --</option>
                                        <option value="Manager">Manager</option>
                                        <option value="Developer">Developer</option>
                                        <option value="HR">HR</option>
                                        <option value="Support">Support</option>
                                    </select>
                                </div>


                             </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label for="DOB" class="form-label">Date Of Birth</label>
                                    <input asp-for="DOB" name="DOB" class="form-control" autocomplete="off">
                                </div>
                                <div class="col-6">
                                    <label for="JoiningDate" class="form-label">Joining Date</label>
                                    <input asp-for="JoiningDate" name="JoiningDate" class="form-control" autocomplete="off">
                                </div>
                            </div>
                            <div class="row mb-3">
                            <div class="col-6">
                                <label for="PhoneNumber">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control" autocomplete="off" />
                                @* <span asp-validation-for="PhoneNumber" class="text-danger"></span> *@
                            </div>
                            <div class="col-6">
                                <label asp-for="Address"></label>
                                <input asp-for="Address" class="form-control" />
                                @* <span asp-validation-for="Address" class="text-danger"></span> *@
                            </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email"></label>
                                <input asp-for="Email" class="form-control" autocomplete="off">
                            </div>
                            <div class="col-12">
                                <label for="Password" class="form-label" autocomplete="off">Password</label>
                                <input asp-for="Password" class="form-control" id="yourPassword" type="password" >
                                
                            </div>

                            <div class="col-12">
                                <label for="ConfPassword" class="form-label" autocomplete="off">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control" id="confirmPassword" type="password" >
                                
                            </div>
                              


                            <div class="col-12">
                                <button class="btn btn-primary w-100 mt-3 mb-3 " type="submit">Create Account</button>
                            </div>
                            <div class="col-12">
                                <p class="small mb-0">Already have an account? <a asp-controller="Auth" asp-action="Login">Log in</a></p>
                            </div>
                        </form>
                    </div>
                    @await Html.PartialAsync("_LoadingPartial")

                </div>

            </div>
        </div>
    </div>
</section>


@section Scripts {

	<script src="~/js/auth/register.js"></script>
}

