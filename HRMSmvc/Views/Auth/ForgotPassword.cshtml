@model Domain.DTO.ForgotPasswordDTO
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LoginLayout";
}
<section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                <div class="card mb-3">
                    <div class="card-body">

                        <div class="pt-4 pb-2">
                            <h5 class="card-title text-center pb-0 fs-4">Reset Password </h5>
                            <p class="text-center small">Enter your email </p>
                        </div>

                        <form id="forgotPasswordform" asp-action="ForgotPassword" method="post">
                            <div class="col-12">
                                <label for="yourUsername" class="form-label">Email</label>
                                <div class="input-group has-validation">
                                    <span id="inputGroupPrepend"></span>
                                    <input asp-for="Email" class="form-control" id="yourUsername" autocomplete="off" required>
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100 mt-3 mb-3" type="submit">Send Reset Link</button>
                            </div>
                            <div class="col-12">
                                <p class="small mb-0"> <a asp-controller="Auth" asp-action="Login">Back to Login</a></p>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
