@model Domain.DTO.ResetPasswordDTO
@{
    ViewData["Title"] = "Reset Password";
	Layout = "_LoginLayout";
}

<section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                <div class="card mb-3">
                    <div class="card-body">

                        <div class="pt-4 pb-2">
                            <h5 class="card-title text-center pb-0 fs-4">Reset Password </h5>
                            <p class="text-center small">Enter your email </p>
                        </div>

                        <form id="resetPwdform" asp-action="ForgotPassword" method="post">
                            <div class="col-12">
                                <label for="Email" class="form-label">Email</label>
                                <div class="input-group has-validation">
                                    <span id="inputGroupPrepend"></span>
                                    <input asp-for="Email" type="email" class="form-control" readonly />
                                </div>
                            </div>

                            <input type="hidden" asp-for="Token" />

                            <div class="col-12">
                                <label for="NewPassword" class="form-label">New Password</label>
                                <div class="input-group has-validation">
                                    <span id="inputGroupPrepend"></span>
                                    <input asp-for="NewPassword" type="password" class="form-control" />
                                    <div class="invalid-feedback">Enter the password.</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <div class="input-group has-validation">
                                    <span id="inputGroupPrepend"></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                    <div class="invalid-feedback">Enter the password.</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary w-100 mt-3 mb-3" type="submit">Reset Password</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

