
<div class="modal fade" id="RejectModal" tabindex="-1" aria-labelledby="RejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="RejectModalLabel">Reject Leave Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="leaveRequestId" value="@Model" />

                <div class="mb-3">
                    <label for="rejectReason" class="form-label">Reason for Rejection</label>
                    <textarea id="rejectReason" class="form-control" rows="3" placeholder="Enter reason for rejecting this leave..." required></textarea>
                </div>

                <div class="text-danger small" id="rejectError" style="display:none;">
                    Please enter a reason before submitting.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmRejectBtn" class="btn btn-danger">Reject Leave</button>
            </div>
        </div>
    </div>
</div>
