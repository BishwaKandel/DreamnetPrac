@using Domain.DTO
@model PayrollDTO
@{
    ViewData["Title"] = "Generate Payroll";
    Layout = "_Layout";

}

<div class="card">
    <div class="card-body">
        <h3 class="card-title">Generate Payroll</h3>


<form asp-action="GeneratePayroll" asp-controller="Payroll" asp-area="Admin" id="genpayrollForm" method="post">
    <input type="hidden" id ="userId" name="userId" value="@Model.UserId" />
            <div class="row mb-3 mt-3">
                <div class="col-6">
                    <label asp-for="Year">Year</label>
                    <select asp-for="Year" class="form-control">
                        <option value="">Select Year</option>
                        <option value="2023">2023</option>
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                        <!-- Add more years as needed -->
                    </select>
                </div>
                <div class="col-6">
                    <label asp-for="Month">Month</label>
                    <select asp-for="Month" class="form-control">
                        <option value="">Select Month</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>

            </div>
            <div class="row mb-3 mt-3">
                <div class="col-4">
                    <label asp-for="BasicSalary"></label>
                    <input asp-for="BasicSalary" class="form-control" />
                    @* <span asp-validation-for="PhoneNumber" class="text-danger"></span> *@
                </div>
                <div class="col-4">
                    <label asp-for="Allowances"></label>
                    <input asp-for="Allowances" class="form-control" />
                    @* <span asp-validation-for="PhoneNumber" class="text-danger"></span> *@
                </div>
                <div class="col-4">
                    <label asp-for="Deductions"></label>
                    <input asp-for="Deductions" class="form-control" />
                    @* <span asp-validation-for="PhoneNumber" class="text-danger"></span> *@
                </div>
            </div>
        <div class="text-center">
        <button type="submit" class="btn btn-primary mt-3 mb-3">Generate</button>
        <a asp-controller="Dashboard" asp-action="Index" asp-area="Admin" class="btn btn-secondary">Back</a>
    </div>
</form>
</<div>

</div>

@section Scripts {
    <script src="~/js/payroll.js"></script>
}